option_settings:
  aws:elasticbeanstalk:application:environment:
    AWS_REGION: "us-east-1"
    AWS_DEFAULT_REGION: "us-east-1"
    # ARN del secreto con credenciales de PostgreSQL (Secrets Manager).
    # El instance profile del entorno EB debe permitir secretsmanager:GetSecretValue.
    DB_SECRET_ARN: "arn:aws:secretsmanager:us-east-1:327006267123:secret:rds!db-33e3cf37-6465-40ac-aa3f-cc54b1148153-acn5La"
    # ARN del secreto con JWT_SECRET_KEY (texto plano o JSON {"JWT_SECRET_KEY":"..."}).
    JWT_SECRET_ARN: "arn:aws:secretsmanager:us-east-1:104073949253:secret:prod/blacklist/jwt_secret_key-3goVmW"
